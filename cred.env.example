# ============================================================
#  Realx8-Core — environment
#  Copy to cred.env (which is gitignored) and fill in.
#      cp cred.env.example cred.env
#  Every service reads this same file, so there is one place to set a secret.
# ============================================================

# ── Composition ───────────────────────────────────────────────
# Which services THIS process owns. Unset (or "all") means all of them in one
# process — the default, and what you want until a single service needs to scale
# on its own. To split one out, list the rest here and give the split-out
# service's URL below. `npm run routes` prints the resulting composition.
# SERVICES=user,auth,property,investment,crm,finance,notification

PORT=3000

# Where each service lives WHEN IT IS NOT IN THIS PROCESS. Ignored for any
# service named in SERVICES. Defaults to localhost on the port below.
# AUTH_SERVICE_URL=https://auth.example.com          # standalone port 3001
# USER_SERVICE_URL=https://user.example.com          # standalone port 3002
# PROPERTY_SERVICE_URL=https://property.example.com  # standalone port 3003
# INVESTMENT_SERVICE_URL=https://investment.example.com  # 3004
# CRM_SERVICE_URL=https://crm.example.com            # standalone port 3005
# FINANCE_SERVICE_URL=https://finance.example.com    # standalone port 3006
# NOTIFICATION_SERVICE_URL=https://notify.example.com    # 3007
# SUPPORT_SERVICE_URL=https://support.example.com    # standalone port 3008

# ── Database ──────────────────────────────────────────────────
# One shared database, usually MySQL unless DB_DIALECT=postgres. Each service
# owns its own tables; a few read each other's (see platform/boot.js).
# mysql (default) or postgres. Selects the Sequelize dialect and which driver
# (mysql2 or pg) is used. Leave unset for MySQL.
# DB_DIALECT=postgres
DB_HOST=localhost
# Postgres users should set DB_PORT=5432.
DB_PORT=3306
DB_NAME=realto
DB_USER=root
DB_PASSWORD=

REDIS_URL=redis://localhost:6379

# ── Cache ────────────────────────────────────────────────────────────────────
# Redis backs the permission, settings and notification-config caches. If
# REDIS_URL is unset or unreachable the backend falls back to an in-process
# cache and keeps working — with one caveat worth knowing: across MULTIPLE
# instances each keeps its own copy, so an eviction on one is invisible to the
# others until the TTL lapses (minutes, see shared/src/cache.js).
#
# CACHE_ENABLED=false turns caching off entirely — the switch to flip first if
# you ever suspect a stale-data problem.
CACHE_ENABLED=true
# Namespace, so two deployments can share one Redis without colliding.
CACHE_PREFIX=realx8

# ── API payload encryption ───────────────────────────────────────────────────
# Encrypts request and response BODIES with AES-256-GCM, on top of HTTPS.
#
# Read shared/src/payloadCrypto.js before switching this on. In short: HTTPS is
# what makes the traffic private; this keeps payloads out of casual view and
# raises the cost of scripting the API. It hides nothing from the signed-in
# user, whose own browser holds the key.
#
#   off         (default) inert
#   permissive  accepts encrypted AND plaintext — deploy in this mode first,
#               so the UI and API can roll out in either order
#   strict      refuses a plaintext body on a non-exempt route
#
# Go to strict only once the logs show no plaintext callers left; it locks out
# anything not updated, including any mobile or server-to-server client.
PAYLOAD_ENCRYPTION_MODE=off
# Session keys are derived from this via HKDF. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates every open session's key (they recover on the next
# sign-in). Falls back to JWT_SECRET if unset, which is fine for development
# and worth separating in production.
PAYLOAD_ENCRYPTION_SECRET=

# ── Auth ──────────────────────────────────────────────────────
# Must be the same value everywhere, in every deployment shape: the edge signs
# and verifies access tokens with it.
JWT_SECRET=
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_DAYS=7

# ── Realx8-Ui ─────────────────────────────────────────────────
# Every origin the UI is served from, comma separated. The browser blocks API
# calls from an origin that is not listed here. Preview hosts (*.vercel.app,
# *.trycloudflare.com, *.pages.dev) are allowed automatically — see
# shared/src/appOrigin.js.
CORS_ORIGIN=http://localhost:5173

# FALLBACK ONLY. Links in outgoing email use the origin of the browser that
# triggered the action, so they follow whatever host you are really on (a
# rotating tunnel, a preview deploy, production). This is used only when there
# is no browser behind the request — a script or a scheduled job. Unset means
# such emails ship without a CTA button, which is safer than a wrong one.
# In production set this to the canonical domain, never to localhost.
FRONTEND_URL=http://localhost:5173

# ── Google OAuth (auth-service) ───────────────────────────────
# Also settable per-company in the settings table, which takes precedence.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LIVE: this must be the deployed API origin, and must match EXACTLY one of the
# "Authorised redirect URIs" registered in the Google Cloud console — Google
# compares the string, so a trailing slash or http-vs-https is a mismatch.
#   https://<your-render-service>.onrender.com/api/auth/google/callback
# These three can also be set in Settings -> System Config, which takes
# precedence over the environment: see services/auth-service/src/index.js.
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
FRONTEND_GOOGLE_CALLBACK_URL=http://localhost:5173/auth/google/callback

# ── Email (notification-service + shared/notifier) ────────────
# Per-company SMTP in the settings table overrides these.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Media uploads (user-service) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Absolute base used to turn a relative /uploads path into a URL a social
# network can fetch. Set this to the public API origin in production.
# PUBLIC_BASE_URL=https://api.example.com

# ── Payment gateways (finance-service) ────────────────────────
# Keys themselves live in the `settings` table, set from Settings → Payment
# Gateways (per company, with a platform-wide fallback) — not here. This only
# caps how long a credential check waits on the gateway.
# PAYMENT_PROBE_TIMEOUT_MS=8000

# ── Social insights sync (user-service) ───────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TWITTER_BEARER_TOKEN=
LINKEDIN_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
YOUTUBE_API_KEY=
IMPRESSIONS_SYNC_CRON=0 */6 * * *

# ── Operational ───────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
# Number of reverse proxies in front of this app (nginx, Railway, a load
# balancer). Unset means rate limiting keys on the proxy's IP rather than the
# client's — fine locally, wrong in production behind a proxy.
# TRUST_PROXY=1
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=500

# ── Security filters (platform/security) ──────────────────────────────────────
# Set TRUST_PROXY=true ONLY when this process really sits behind a proxy that
# rewrites X-Forwarded-For. Left false, that header is ignored — otherwise any
# caller could choose their own rate-limit bucket and bypass the IP allow-list
# by adding a header.
# TRUST_PROXY=false

# CORS. Unset falls back to the shared appOrigin allow-list. A bare "*" is
# honoured but FORCES credentials off, because wildcard-plus-credentials lets
# any site the user visits call this API with their session.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://app.realx8.com
# CORS_ALLOW_CREDENTIALS=true
# CORS_MAX_AGE=3600

# Automated tool blocking. strict additionally requires the request to LOOK
# like a browser (recognised User-Agent plus Accept, Accept-Language and
# Accept-Encoding), which is what stops a tool merely changing its User-Agent.
# Turning strict off still blocks named tools and tool-specific headers.
# WARNING: with these on, curl, Postman, mobile and server-to-server clients
# are refused. Add server IPs to the allow-list rather than turning it off.
SECURITY_BLOCK_TOOLS_ENABLED=true
SECURITY_BLOCK_TOOLS_STRICT=true
# SECURITY_BLOCK_TOOLS_WHITELIST=10.0.0.5,10.0.0.6

# Device fingerprinting. Records which devices an account uses and caps how
# many. It is an audit trail, NOT a second factor — every input is a header the
# caller controls. trust-new is true because there is no approval screen, so
# distrusting new devices would lock users out with no way back in.
SECURITY_DEVICE_FINGERPRINT_ENABLED=true
SECURITY_DEVICE_TRUST_NEW=true
SECURITY_DEVICE_MAX_PER_USER=10
# SECURITY_DEVICE_SESSION_TIMEOUT=86400

# Frontend request signature. MUST match Realx8-Ui's VITE_FRONTEND_* values or
# every request is refused with 403.
# The key ships inside the browser bundle and is readable there, so it is a
# barrier against casual scripting, not a secret — see
# platform/security/frontendHeader.js. Unset means requests are NOT verified,
# and the server says so on startup.
SECURITY_FRONTEND_HEADER_ENABLED=true
SECURITY_FRONTEND_APP_ID=realx8-ui
SECURITY_FRONTEND_SECRET=change-me-to-match-the-ui
# SECURITY_FRONTEND_HEADER_NAME=x-realx8-auth
# SECURITY_FRONTEND_HEADER_TIMEOUT=300

# Layered rate limiting, per minute. Counters are in-process: with N instances
# behind a load balancer the effective limit is roughly N x these values.
SECURITY_RATE_LIMIT_ENABLED=true
# SECURITY_RATE_LIMIT_IP=300
# SECURITY_RATE_LIMIT_IP_LOGIN=10
# SECURITY_RATE_LIMIT_USER=240
# SECURITY_RATE_LIMIT_USER_PAYMENT=20
# SECURITY_RATE_LIMIT_ENDPOINT=120

# ── One active session per user ──────────────────────────────────────────────
# A user signing in while another of their sessions is still alive is refused.
# They get in once that session signs out, or goes quiet for long enough.
# Currently OFF while a reported misbehaviour is investigated. Set to true to
# re-enable; the default is false, so it is off wherever this is unset.
SINGLE_SESSION_ENABLED=false
# The inactivity window. This doubles as the wait a user feels after closing
# the browser WITHOUT signing out: they cannot sign in again until it lapses.
# Shorten it if that wait is the complaint; lengthen it if sessions are ending
# while people are still working.
SESSION_INACTIVITY_MINUTES=30
#
# The registry lives in the cache, so its TTL is the inactivity rule. If the
# cache is lost (Redis restart), sessions read as absent and sign-ins are
# ALLOWED — fail-open on purpose: a single-session rule is account hygiene, and
# it must never be able to lock every user out.

# ── Integration callbacks ────────────────────────────────────────────────────
# Inbound traffic from payment providers, OAuth and similar is exempt from the
# browser-shaped checks (automated-tool detection, the signed frontend header,
# device fingerprinting, payload encryption) — none of which it could satisfy,
# being a server rather than our page in a browser.
#
# NOTE: calls this backend MAKES to a third party are unaffected by any of
# this. CORS is a browser rule; a server-side request ignores it, and the
# filters only ever see inbound traffic.
#
# Additive to the built-in list (/webhooks/**, /integrations/**, OAuth
# callbacks). Comma-separated.
INTEGRATION_EXEMPT_PATHS=
# Integration paths keep their rate limit by default — an exempt path is open
# to anyone, so the limit is the only thing bounding an abusive caller.
INTEGRATION_EXEMPT_RATE_LIMIT=false
#
# AN EXEMPT ENDPOINT MUST AUTHENTICATE ITS CALLER ITSELF, with the provider's
# signature (x-paystack-signature, verif-hash, stripe-signature). Exempt means
# "not judged as a browser", not "trusted" — the URL is reachable by anyone.
