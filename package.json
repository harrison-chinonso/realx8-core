{
  "name": "realx8-core",
  "version": "1.0.0",
  "private": true,
  "description": "Realx8 backend \u2014 nine services, one deployable, splittable per service.",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "services/*",
    "shared"
  ],
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch server.js --watch platform --watch shared --watch services --ext js server.js",
    "dev:all": "node scripts/dev-all.js",
    "install:all": "node scripts/install-all.js",
    "dev:split": "concurrently -n gateway,auth,user,property,investment,crm,finance,notification,support \"npm run dev --workspace services/api-gateway\" \"npm run dev --workspace services/auth-service\" \"npm run dev --workspace services/user-service\" \"npm run dev --workspace services/property-service\" \"npm run dev --workspace services/investment-service\" \"npm run dev --workspace services/crm-service\" \"npm run dev --workspace services/finance-service\" \"npm run dev --workspace services/notification-service\" \"npm run dev --workspace services/support-service\"",
    "build": "npm run build --workspaces --if-present",
    "routes": "node platform/routes.js",
    "seed": "node services/user-service/src/migrations/seed.js",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:split:up": "docker compose -f docker-compose.split.yml up -d --build",
    "docker:split:down": "docker compose -f docker-compose.split.yml down",
    "verify:purchase": "node scripts/verify-purchase-journey.js",
    "verify:cache": "node scripts/verify-cache.js",
    "verify:crypto": "node scripts/verify-payload-encryption.js",
    "payload:bootstrap-key": "node scripts/print-bootstrap-key.js",
    "verify:session": "node scripts/verify-single-session.js",
    "verify:security": "node scripts/verify-security.js",
    "security:config": "node scripts/print-security-config.js",
    "verify:list": "node scripts/verify-list-query.js",
    "verify:references": "node scripts/verify-references.js",
    "verify:dialect": "node scripts/verify-dialect.js",
    "verify:settings-scope": "node scripts/verify-settings-scope.js",
    "verify:branches": "node scripts/verify-branches.js",
    "verify:realtor-gate": "node scripts/verify-realtor-verification-gate.js",
    "verify:investments": "node scripts/verify-investment-accrual.js && node scripts/verify-investment-lifecycle.js",
    "verify:referral": "node scripts/verify-referral-link.js",
    "verify:audit": "node scripts/verify-audit-log.js",
    "verify:commission": "node scripts/verify-commission-engine.js",
    "verify:commission-store": "node scripts/verify-commission-store.js",
    "verify:commission-phases": "node scripts/verify-commission-phases.js",
    "lint:sql": "node scripts/lint-sql-dialect.js",
    "lint": "eslint .",
    "diagnose:indexes": "node scripts/diagnose-indexes.js",
    "verify:boot-lock": "node scripts/verify-boot-lock.js",
    "verify:cloudinary": "node scripts/verify-cloudinary-config.js",
    "verify:upload": "node scripts/verify-media-upload.js",
    "diagnose:enums": "node scripts/diagnose-enums.js",
    "verify:mail": "node scripts/verify-mail-fallback.js",
    "verify:settings-queries": "node scripts/verify-settings-queries.js",
    "diagnose:google": "node scripts/diagnose-google-oauth.js",
    "verify:top-performers": "node scripts/verify-top-performers.js",
    "verify:jwt-secret": "node scripts/verify-jwt-secret.js",
    "verify:commission-lifecycle": "node scripts/verify-commission-lifecycle.js",
    "verify:receipt-policy": "node scripts/verify-receipt-policy.js",
    "verify:invoice-discount": "node scripts/verify-invoice-discount.js",
    "verify:notes": "node scripts/verify-note-approval.js",
    "verify:reminders": "node scripts/verify-payment-reminders.js",
    "verify:permissions": "node scripts/verify-permission-backfill.js",
    "verify:promotions": "node scripts/verify-promotions.js",
    "verify:promotion-publish": "node scripts/verify-promotion-publish.js",
    "verify:media-publish": "node scripts/verify-media-publish.js",
    "verify:realtor-charges": "node scripts/verify-realtor-charges.js",
    "verify:promotion-store": "node scripts/verify-promotion-store.js",
    "verify:promotion-purchase": "node scripts/verify-promotion-purchase.js",
    "verify:google": "node scripts/verify-google-signup.js",
    "verify:backfill": "node scripts/verify-company-backfill.js",
    "verify:ladder": "node scripts/verify-realtor-ladder.js",
    "verify:crm-permissions": "node scripts/verify-crm-permissions.js",
    "verify:routes": "node scripts/verify-route-permissions.js",
    "verify:security-grant": "node scripts/verify-security-grant.js",
    "verify:2fa-policy": "node scripts/verify-2fa-policy.js",
    "verify:sms": "node scripts/verify-sms.js",
    "verify:platform-permissions": "node scripts/verify-platform-permissions.js",
    "verify:security-fixes": "node scripts/verify-security-fixes.js",
    "verify:ledger": "node scripts/verify-ledger.js",
    "verify:posting": "node scripts/verify-posting.js",
    "verify:payables": "node scripts/verify-payables.js",
    "verify:development": "node scripts/verify-development-cost.js",
    "verify:statements": "node scripts/verify-statements.js",
    "verify:close": "node scripts/verify-period-close.js",
    "verify:bank-rec": "node scripts/verify-bank-rec.js",
    "verify:acct-dialect": "node scripts/verify-accounting-dialect.js",
    "test": "node --test test/",
    "verify:migration": "node scripts/verify-migration.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^7.2.0",
    "http-proxy-middleware": "^3.0.3",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "nodemon": "^3.1.7"
  }
}
